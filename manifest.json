{
  "manifest_version": 3,
  "name": "مُشغّل الروابط اليومي",
  "version": "2.0",
  "author": "Mahmoud Ghosheh",
  "description": "إضافة متطورة لفتح وتجميع الروابط مجدولة الأيام تلقائياً مع مزامنة سحابية ودعم الوضع الليلي.",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "tabGroups"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "إدارة الروابط اليومية"
  }
}